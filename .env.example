# Настройки SEO-дашборда. Скопируйте в .env (или выполните `seo-dashboard init-env`)
# и заполните. Файл .env содержит секреты и не попадает в репозиторий.

# --- База данных (PostgreSQL 17) ---------------------------------------------
# Формат: postgresql+psycopg://<пользователь>:<пароль>@<хост>:<порт>/<база>
DATABASE_URL=postgresql+psycopg://seo_dashboard:change-me@localhost:5432/seo_dashboard

# --- Веб-сервер -------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
# Внешний адрес приложения (на сервере — https://ваш-домен). Нужен для OAuth redirect URI.
PUBLIC_BASE_URL=http://localhost:8000

# --- Безопасность -----------------------------------------------------------
# Ключ подписи cookie сессии: длинная случайная строка.
SECRET_KEY=change-me
# Ключ шифрования токенов и API-ключей в БД (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: при потере или смене ключа сохранённые доступы придётся подключать заново.
ENCRYPTION_KEY=change-me
SESSION_MAX_AGE_DAYS=14
# На сервере с HTTPS установите true.
SESSION_COOKIE_SECURE=false

# --- Сбор данных ------------------------------------------------------------
APP_TIMEZONE=Europe/Minsk
SCHEDULER_ENABLED=true
DAILY_SYNC_HOUR=4
DAILY_SYNC_MINUTE=0
REWRITE_WINDOW_DAYS=5
RAW_RETENTION_DAYS=90
DEFAULT_SIGNAL_THRESHOLD_PCT=10

# --- OAuth-приложения Google и Яндекса ----------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Redirect URI: <PUBLIC_BASE_URL>/api/oauth/google/callback
# Новые входы идут через приложение _1. Ключи приложений, через которые раньше подключались
# аккаунты, оставьте под номерами _2, _3…: токен обновляется только выдавшим его приложением.
GOOGLE_CLIENT_ID_1=
GOOGLE_CLIENT_SECRET_1=
# https://oauth.yandex.ru → Создать приложение (права Метрики и Вебмастера).
# Redirect URI: https://oauth.yandex.ru/verification_code (код вставляется в дашборд).
YANDEX_CLIENT_ID_1=
YANDEX_CLIENT_SECRET_1=
